# ─────────────────────────────────────────────────────────────────────────────
# UniCal AI — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Service-role key — only used server-side (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── AI (Vercel AI SDK) ────────────────────────────────────────────────────────
# Anthropic Claude (Phase 3)
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# ── App ───────────────────────────────────────────────────────────────────────
# The public URL of your deployment (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
